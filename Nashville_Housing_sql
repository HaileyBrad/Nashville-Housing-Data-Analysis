-- Changing SoldAsVacant Boolean to Yes or NO 

SELECT soldasvacant, COUNT(SoldAsVacant)
FROM `fit-territory-457803-f3.Nashville_Data.Nashville_Housing`
GROUP BY soldasvacant
LIMIT 100;

SELECT 
  CASE
    WHEN soldasvacant = TRUE THEN 'Yes'
    WHEN soldasvacant = FALSE THEN 'No'
    ELSE CAST(soldasvacant AS STRING)
    END
    AS sold_as_vacant_status
FROM `fit-territory-457803-f3.Nashville_Data.Nashville_Housing`;

ALTER TABLE `fit-territory-457803-f3.Nashville_Data.Nashville_Housing`
ADD COLUMN sold_as_vacant_status STRING;

update `fit-territory-457803-f3.Nashville_Data.Nashville_Housing`
set sold_as_vacant_status =  CASE
    WHEN soldasvacant = TRUE THEN 'Yes'
    WHEN soldasvacant = FALSE THEN 'No'
    ELSE CAST(soldasvacant AS STRING)
    END
where true;

--Removing Duplicates with View

CREATE OR REPLACE VIEW `fit-territory-457803-f3.Nashville_Data.clean_housing` AS
WITH RowNumCTE AS (
  SELECT *,
         ROW_NUMBER() OVER (
           PARTITION BY ParcelID, PropertyAddress, SaleDate, LegalReference, OwnerName
           ORDER BY `UniqueID `
         ) AS row_num
  FROM `fit-territory-457803-f3.Nashville_Data.Nashville_Housing`
)
SELECT *
FROM RowNumCTE
WHERE row_num = 1;

SELECT
  ParcelID,
  PropertyAddress,
  SaleDate,
  LegalReference,
  OwnerName,
  COUNT(*) AS count_rows
FROM `fit-territory-457803-f3.Nashville_Data.clean_housing`
GROUP BY 1,2,3,4,5
HAVING COUNT(*) > 1;

--pricing trends over time
SELECT
  EXTRACT(YEAR FROM SaleDate) AS sale_year,
  AVG(SalePrice) AS avg_sale_price
FROM `fit-territory-457803-f3.Nashville_Data.clean_housing`
GROUP BY sale_year
ORDER BY sale_year;
-- Number of Sales by Year

SELECT
  EXTRACT(YEAR FROM SaleDate) AS sale_year,
  COUNT(*) AS total_sales
FROM `fit-territory-457803-f3.Nashville_Data.clean_housing`
GROUP BY sale_year
ORDER BY sale_year;

-- Average sale Price by City 

SELECT
  PropertySplitCity,
  AVG(SalePrice) AS avg_sale_price,
  COUNT(*) AS total_sales
FROM `fit-territory-457803-f3.Nashville_Data.clean_housing`
GROUP BY PropertySplitCity
HAVING COUNT(*) > 50
ORDER BY avg_sale_price DESC;

-- Vacant vs non Vacant 

SELECT
  sold_as_vacant_status,
  AVG(SalePrice) AS avg_sale_price
FROM `fit-territory-457803-f3.Nashville_Data.clean_housing`
GROUP BY sold_as_vacant_status;

--Top owners

SELECT
  OwnerName,
  COUNT(*) AS properties_owned,
  AVG(SalePrice) AS avg_sale_price
FROM `fit-territory-457803-f3.Nashville_Data.clean_housing`
GROUP BY OwnerName
HAVING COUNT(*) > 1
ORDER BY properties_owned DESC;

