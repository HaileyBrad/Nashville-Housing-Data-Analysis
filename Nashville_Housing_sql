SELECT a.ParcelID, a.PropertyAddress, b.ParcelID, b.PropertyAddress, IFNULL(a.PropertyAddress, b.PropertyAddress)
FROM `fit-territory-457803-f3.Nashville_Data.Nashville_Housing` a
JOIN `fit-territory-457803-f3.Nashville_Data.Nashville_Housing` b
  ON a.ParcelID = b.ParcelID AND a.`UniqueID ` <> b.`UniqueID `
WHERE a.PropertyAddress IS NULL;

UPDATE `fit-territory-457803-f3.Nashville_Data.Nashville_Housing` a
SET PropertyAddress = (
  SELECT ANY_VALUE(b.PropertyAddress)
  FROM `fit-territory-457803-f3.Nashville_Data.Nashville_Housing` b
  WHERE a.ParcelID = b.ParcelID
    AND b.PropertyAddress IS NOT NULL
)
WHERE a.PropertyAddress IS NULL;

